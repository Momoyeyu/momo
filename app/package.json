{
  "name": "momo-desktop",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "build": "tauri build",
    "build:backend": "node scripts/python.mjs freeze-backend.py",
    "prepare:models": "node scripts/python.mjs prepare-models.py",
    "test:shell": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:macos": "tauri build --bundles app && python3 scripts/package-macos.py",
    "test:native": "wdio run scripts/wdio.conf.mjs",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/tauri-service": "^1.5.0",
    "webdriverio": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "expect-webdriverio": "^6.0.0"
  }
}
