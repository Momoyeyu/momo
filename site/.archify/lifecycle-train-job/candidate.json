{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "训练 job 生命周期 (momoctl jobs)",
    "output": "train-job.html",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "job 推进"
    },
    {
      "id": "exec",
      "label": "执行器"
    },
    {
      "id": "terminal",
      "label": "终态"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "sublabel": "POST /api/jobs",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "job.json"
    },
    {
      "id": "preparing",
      "type": "active",
      "label": "Preparing",
      "sublabel": "数据集校验/切片",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "pipeline"
    },
    {
      "id": "running",
      "type": "active",
      "label": "Running",
      "sublabel": "训练执行 + 日志 SSE",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "checkpoint 每2h"
    },
    {
      "id": "succeeded",
      "type": "success",
      "label": "Succeeded",
      "sublabel": "exit 0 + 产物校验",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "artifacts/"
    },
    {
      "id": "promoted",
      "type": "success",
      "label": "Promoted",
      "sublabel": "登记 MANIFEST + 激活",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "可回滚"
    },
    {
      "id": "local",
      "type": "active",
      "label": "exec_local",
      "sublabel": "本地子进程 · pidfile · 日志落盘",
      "lane": "exec",
      "col": 2,
      "tag": "spawn"
    },
    {
      "id": "ssh",
      "type": "active",
      "label": "exec_ssh",
      "sublabel": "4090D/mac-studio · rsync 回传",
      "lane": "exec",
      "col": 3,
      "tag": "borrowed_night_only"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "exit!=0 / 日志异常",
      "lane": "terminal",
      "col": 2,
      "tag": "可 retry"
    },
    {
      "id": "canceled",
      "type": "failure",
      "label": "Canceled",
      "sublabel": "POST cancel",
      "lane": "terminal",
      "col": 3,
      "tag": "可 retry"
    }
  ],
  "transitions": [
    {
      "from": "queued",
      "to": "preparing"
    },
    {
      "from": "preparing",
      "to": "running",
      "label": "launch"
    },
    {
      "from": "running",
      "to": "succeeded",
      "label": "exit 0"
    },
    {
      "from": "succeeded",
      "to": "promoted",
      "label": "盲听/回归达标"
    },
    {
      "from": "running",
      "to": "local",
      "variant": "dashed"
    },
    {
      "from": "running",
      "to": "ssh",
      "variant": "dashed"
    },
    {
      "from": "running",
      "to": "failed",
      "variant": "security"
    },
    {
      "from": "running",
      "to": "canceled",
      "variant": "security"
    },
    {
      "from": "failed",
      "to": "queued",
      "label": "retry",
      "variant": "dashed"
    },
    {
      "from": "canceled",
      "to": "queued",
      "label": "retry",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "持久化与恢复",
      "items": [
        "job store: jobs/<id>/{job.json,logs/,artifacts/}",
        "重启 momoctl web 后 runner 重扫 store 恢复 running 监控",
        "CLI 与 Web 共用同一份 job store"
      ]
    },
    {
      "dot": "amber",
      "title": "两条内置 pipeline",
      "items": [
        "voice-sft: 参考音频→数据集→SFT→盲听A/B→激活",
        "persona-qlora: 对话素材→build_dataset→lora→回归20题",
        "每步映射 momo-models training/ 脚本"
      ]
    },
    {
      "dot": "rose",
      "title": "借用窗口",
      "items": [
        "borrowed_night_only 标记的 job 只在配置窗口调度",
        "exec_ssh 复用 ~/.ssh/config, 不自管密钥"
      ]
    }
  ]
}