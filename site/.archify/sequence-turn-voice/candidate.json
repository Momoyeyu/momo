      "participant": "brain",
      "from": 414,
      "to": 454,
      "type": "cloud"
    },
    {
      "participant": "tts",
      "from": 500,
      "to": 542,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "延迟预算",
      "items": [
        "语音回合目标 <1.5s 出声 (VAD 判停起算)",
        "ASR 实测 RTF 0.040 / Kokoro 首包 209ms (2026-10-10)",
        "LLM 首 token 预估 300ms, MLX 30B 实测 121 t/s"
      ]
    },
    {
      "dot": "amber",
      "title": "打断变体",
      "items": [
        "Speaking 中 speech_start 或用户插话 → control.barge_in",
